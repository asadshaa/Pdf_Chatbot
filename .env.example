# Groq Cloud API Key (Get a free key at https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq Model (e.g., llama-3.3-70b-versatile, groq/compound-mini, openai/gpt-oss-120b)
GROQ_MODEL=llama-3.3-70b-versatile

# ElevenLabs API Key (Optional, for hyper-realistic voices at https://elevenlabs.io)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
